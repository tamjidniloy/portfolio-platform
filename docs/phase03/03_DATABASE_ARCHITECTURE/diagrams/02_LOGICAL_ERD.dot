digraph Logical {
graph [rankdir=LR,bgcolor="#10151D",pad=".4",nodesep=".38",ranksep=".7",fontsize=20,fontname="Arial",fontcolor="#F1F5F9",label="Phase 03.3 Logical ERD — 18 candidate tables / NOT APPROVED",labelloc=t,overlap=false,splines=polyline];
node [shape=box,style="rounded,filled",fontname="Arial",fontcolor="#F1F5F9",color="#46586B",fillcolor="#17212D",fontsize=10];
edge [color="#70D9C3",fontcolor="#B0BECC",fontsize=9,arrowsize=.55];
subgraph cluster_AUTH { label="AUTH";color="#234b5b";fontcolor="#9CC0FF";style=rounded;
admin_users [label="ADMIN_USERS\nid  (uuid) PK\nemail  (citext/text)\npassword_hash  (text)\nstatus  (text)\ncreated_at  (timestamptz)\n…"];
auth_challenges [label="AUTH_CHALLENGES\nid  (uuid) PK\nadmin_user_id  (uuid)\ncode_digest  (text)\nattempts  (integer)\nexpires_at  (timestamptz)\n…"];
admin_sessions [label="ADMIN_SESSIONS\nid  (uuid) PK\nadmin_user_id  (uuid)\ntoken_digest  (text)\nissued_at  (timestamptz)\nexpires_at  (timestamptz)\n…"];
password_reset_tokens [label="PASSWORD_RESET_TOKENS\nid  (uuid) PK\nadmin_user_id  (uuid)\ntoken_digest  (text)\nexpires_at  (timestamptz)\nused_at  (timestamptz)\n"];
}
subgraph cluster_PUBLISHING { label="PUBLISHING";color="#285449";fontcolor="#9CC0FF";style=rounded;
content_items [label="CONTENT_ITEMS\nid  (uuid) PK\ncontent_type  (text)\ncurrent_slug  (text)\npublication_state  (text)\nlock_version  (bigint)\n…"];
content_revisions [label="CONTENT_REVISIONS\nitem_id  (uuid) PK\nrevision_no  (integer) PK\npayload  (jsonb)\nschema_version  (integer)\npayload_sha256  (text)\n…"];
published_snapshots [label="PUBLISHED_SNAPSHOTS\nitem_id  (uuid) PK\nsource_revision_no  (integer)\npublic_path  (text)\npublic_payload  (jsonb)\npublished_at  (timestamptz)\n…"];
content_relations [label="CONTENT_RELATIONS\nsource_item_id  (uuid) PK\nsource_revision_no  (integer) PK\ntarget_item_id  (uuid) PK\nrelation_kind  (text) PK\ncreated_at  (timestamptz)\n"];
tags [label="TAGS\nid  (uuid) PK\nslug  (text)\nlabel  (text)\n"];
content_tags [label="CONTENT_TAGS\nitem_id  (uuid) PK\nrevision_no  (integer) PK\ntag_id  (uuid) PK\n"];
slug_redirects [label="SLUG_REDIRECTS\nfrom_path  (text) PK\nto_path  (text)\nhttp_status  (integer)\nis_active  (boolean)\ncreated_at  (timestamptz)\n"];
}
subgraph cluster_MEDIA { label="MEDIA";color="#453f64";fontcolor="#9CC0FF";style=rounded;
media_assets [label="MEDIA_ASSETS\nid  (uuid) PK\nstorage_key  (text)\noriginal_name  (text)\ndeclared_mime  (text)\nobserved_mime  (text)\n…"];
media_references [label="MEDIA_REFERENCES\nitem_id  (uuid) PK\nrevision_no  (integer) PK\nmedia_id  (uuid) PK\nuse_role  (text) PK\n"];
}
subgraph cluster_PRIVACY_AND_OPS { label="PRIVACY_AND_OPS";color="#5a3f48";fontcolor="#9CC0FF";style=rounded;
contact_messages [label="CONTACT_MESSAGES\nid  (uuid) PK\nsender_name  (text)\nsender_email  (text)\nmessage_body  (text)\nconsent_at  (timestamptz)\n…"];
audit_events [label="AUDIT_EVENTS\nid  (bigint) PK\nactor_admin_id  (uuid)\naction  (text)\ntarget_kind  (text)\ntarget_id  (uuid)\n…"];
outbox_events [label="OUTBOX_EVENTS\nid  (uuid) PK\nevent_type  (text)\naggregate_id  (uuid)\ndedupe_key  (text)\nsafe_payload  (jsonb)\n…"];
idempotency_keys [label="IDEMPOTENCY_KEYS\nid  (uuid) PK\nscope  (text)\nkey_digest  (text)\nrequest_digest  (text)\nstatus  (text)\n…"];
site_private_config [label="SITE_PRIVATE_CONFIG\nsingleton_id  (smallint) PK\nprivate_config  (jsonb)\nupdated_by  (uuid)\nlock_version  (bigint)\nupdated_at  (timestamptz)\n"];
}
admin_users -> auth_challenges [label="1:N"];
admin_users -> admin_sessions [label="1:N"];
admin_users -> password_reset_tokens [label="1:N"];
admin_users -> content_items [label="1:N"];
content_items -> content_revisions [label="1:N"];
content_items -> published_snapshots [label="1:0..1"];
content_revisions -> published_snapshots [label="1:0..N"];
content_revisions -> content_relations [label="1:N"];
content_items -> content_relations [label="1:N"];
content_revisions -> content_tags [label="1:N"];
tags -> content_tags [label="1:N"];
content_revisions -> media_references [label="1:N"];
media_assets -> media_references [label="1:N"];
admin_users -> audit_events [label="1:N nullable"];
admin_users -> site_private_config [label="1:N"];
slug_redirects -> published_snapshots [style=dashed,label="must target live published path"];
contact_messages -> outbox_events [style=dashed,label="notification intent"];
}

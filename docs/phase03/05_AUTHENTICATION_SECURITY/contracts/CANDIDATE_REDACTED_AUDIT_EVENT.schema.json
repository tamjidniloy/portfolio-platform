{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devfolio.invalid/design/03-5/audit-event.schema.json",
  "title": "Candidate sanitized security audit event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp_utc",
    "event_type",
    "outcome",
    "request_id"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "auth_denied",
        "challenge_issued",
        "challenge_rejected",
        "login_success",
        "session_revoked",
        "admin_access_denied",
        "content_published",
        "content_unpublished",
        "media_rejected",
        "contact_spam_rejected",
        "credential_rotated"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "pending",
        "error"
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "actor_pseudonym": {
      "type": "string",
      "maxLength": 128
    },
    "resource_class": {
      "type": "string",
      "maxLength": 80
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 12
    }
  },
  "additionalProperties": false,
  "description": "DO NOT add user emails, OTP, raw tokens, full contact messages, draft payload or credentials."
}

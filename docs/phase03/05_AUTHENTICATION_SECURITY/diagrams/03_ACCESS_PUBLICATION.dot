digraph G {graph [rankdir=LR,bgcolor="#10151d",pad="0.35",label="03.5 · Published-Only Data Boundary",labelloc=t,fontname="Arial",fontsize=22,fontcolor="#f1f5f9"];node [shape=box,style="rounded,filled",fillcolor="#17212d",color="#415669",fontcolor="#f1f5f9",fontname="Arial",fontsize=12];edge[color="#70d9c3",fontcolor="#c4e5d6",fontname="Arial",fontsize=10];anon[label="Anonymous SSR / API / Sitemap"];safe[label="Published Query Facade\nDTO Allowlist",fillcolor="#18453f"];snap[label="Published Snapshots\nApproved Public Fields",fillcolor="#18453f"];owner[label="Owner Active Session"];private[label="Policy + CSRF + Revision\nAuthorized Commands",fillcolor="#245069"];draft[label="Drafts / Revisions\nPrivate Data",fillcolor="#604b2c"];publish[label="Atomic Publish / Unpublish\nDB Commit + Outbox",fillcolor="#245069"];cache[label="Public Cache / SEO\nNo private drafts",fillcolor="#18453f"];anon->safe;safe->snap;snap->cache;owner->private;private->draft;private->publish;publish->snap[label="approved state"];draft->safe[label="FORBIDDEN",color="#ed6676",style=dashed];}

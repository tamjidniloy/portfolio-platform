digraph G {graph [rankdir=LR,bgcolor="#10151d",pad="0.35",label="03.5 · Candidate Login & Recovery States — NOT APPROVED",labelloc=t,fontname="Arial",fontsize=21,fontcolor="#f1f5f9"];node [shape=box,style="rounded,filled",fillcolor="#17212d",color="#3c5568",fontcolor="#f1f5f9",fontname="Arial",fontsize=12];edge[color="#70d9c3",fontcolor="#e5edf5",fontname="Arial",fontsize=10];s[label="Unauthenticated"];p[label="Password Verified\nPending Challenge",fillcolor="#604b2c"];o[label="Active Owner Session",fillcolor="#18453f"];x[label="Denied / Expired",fillcolor="#5b2b3b"];r[label="Recovery Proof\n(requires approved policy)",fillcolor="#604b2c"];s->p[label="password succeeds"];s->x[label="invalid / throttled"];p->o[label="selected authenticators succeed"];p->x[label="expiry / replay / invalid"];o->s[label="logout / revocation"];s->r[label="recovery request"];r->s[label="rotate and revoke all"];r->x[label="invalid / failed"];o->x[label="expiry / compromise"]; }

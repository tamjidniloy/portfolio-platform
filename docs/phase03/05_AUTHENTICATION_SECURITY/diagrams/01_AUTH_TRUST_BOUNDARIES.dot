digraph G {graph [rankdir=LR,bgcolor="#10151d",pad="0.35",nodesep="0.55",ranksep="0.7",fontname="Arial",label="DEVFOLIO OS · 03.5 Auth and Trust Boundaries",labelloc=t,fontsize=23,fontcolor="#f1f5f9"];node [shape=box,style="rounded,filled",fillcolor="#17212d",color="#3c5568",fontcolor="#e5edf5",fontname="Arial",fontsize=12,margin="0.21,0.15"]; edge[color="#70d9c3",fontcolor="#a7c7d6",fontname="Arial",fontsize=10]; visitor[label="Public Visitor / Crawler"]; owner[label="Owner Browser"]; edgeproxy[label="TLS Edge + Proxy",fillcolor="#1f3345"]; rr[label="React Router SSR / Express",fillcolor="#1f3345"]; middleware[label="Auth Session + CSRF\nPolicy Middleware",fillcolor="#18453f"]; public[label="Published Query + DTO\nAllowlist",fillcolor="#18453f"]; admin[label="Owner Command Ports\nPrivate Preview",fillcolor="#18453f"]; db[label="PostgreSQL\nOwner / Draft / Snapshots",fillcolor="#242b4b"]; mail[label="External Email\nDelivery",fillcolor="#242b4b"]; media[label="Private Media Storage",fillcolor="#242b4b"];visitor->edgeproxy;owner->edgeproxy;edgeproxy->rr;rr->public[label="anonymous"];rr->middleware[label="admin routes"];middleware->admin[label="active verified owner"];public->db[label="published only"];admin->db;admin->media;middleware->mail[label="challenge delivery\nnot session grant",style=dashed];}

digraph DEVFOLIO {
  graph [label="DEVFOLIO OS | Candidate Integrated Architecture / Phase 03.7",labelloc=t, fontsize=24, bgcolor="#0f1724", fontname="DejaVu Sans", fontcolor="#d9e8f4", pad="0.5", ranksep="0.7", nodesep="0.38"];
  node [shape=box, style="rounded,filled", fillcolor="#1b2938", color="#5c788d", fontname="DejaVu Sans", fontcolor="#e3eff8",fontsize=10,margin="0.2,0.12"];
  edge [color="#70d9c3",fontcolor="#a5c7df",fontsize=9,arrowsize=.7];
  visitor [label="Visitor / crawler\n(public requests)"];
  owner [label="Owner admin\n(authorised session)"];
  edgegw [label="TLS edge & policies\nrate limit / safe headers"];
  visitor -> edgegw [label="HTTPS"]; owner -> edgegw [label="HTTPS"];
  subgraph cluster_app {label="Single Node/Express + React Router SSR application (candidate modular monolith)";fontcolor="#c8dfed"; color="#355568";
   web [label="SSR routes / resource endpoints"];
   pub [label="Published-only queries\nallowlisted public DTOs",fillcolor="#163b3c",color="#70d9c3"];
   adm [label="Owner app commands\nauth / CSRF / policy",fillcolor="#403044",color="#d0aeea"];
   usecase [label="Domain use cases\nrevisions / publish / media / contact"];
   worker [label="Retryable outbox worker"];
   web -> pub [label="anon reads"];web -> adm [label="owner reads/writes"];
   adm -> usecase; usecase -> worker [style=dashed,label="post-commit signal"];
  }
  edgegw -> web;
  subgraph cluster_data {label="Private operations and external providers";fontcolor="#c8dfed";color="#355568";
   psql [shape=cylinder,label="PostgreSQL\nprivate revisions + published snapshots",fillcolor="#243b49"];
   media [shape=cylinder,label="Object storage\nprivate staging + published assets"];
   mail [label="Transactional email service"];
   observ [label="Sanitized telemetry / alerts"];
   backup [shape=cylinder,label="Encrypted backup / restore vault"];
  }
  pub -> psql [label="published projection only"];
  usecase -> psql [label="transactional writes"];
  usecase -> media;worker -> mail;worker -> observ;psql -> backup [style=dotted,label="isolated restore"];
  {rank=same;visitor;owner;}
}

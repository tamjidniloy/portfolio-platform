
digraph G {
 rankdir=TB;bgcolor="#0f1724";pad=.4;splines=polyline;node[shape=box,style="rounded,filled",fillcolor="#172536",fontcolor="#f0f7fb",color="#48647b",fontname="DejaVu Sans",fontsize=11,margin=".22,.15"];edge[color="#79d4bd",arrowsize=.7,fontcolor="#eff"];
 Primary [label="Production managed PostgreSQL",fillcolor="#233d56"];
 Assets [label="Private media + published references",fillcolor="#483452"];
 Backup [label="Encrypted base backup + optional WAL/PITR\nmanifest and checksum",fillcolor="#16544f"];
 Object [label="Versioned media backup\nreference manifest",fillcolor="#16544f"];
 Vault [label="Isolated recovery vault\nindependent delete rights",fillcolor="#4d452f"];
 Restore [label="Isolated restore environment\nno real outgoing email",fillcolor="#1d3c51"];
 Verify [label="DB integrity + published-only probes\nmeasured RTO/RPO",fillcolor="#1d3c51"];
 Decision [label="Owner-controlled cutover / abort",fillcolor="#4d452f"];
 Primary->Backup;Assets->Object;Backup->Vault;Object->Vault;Vault->Restore;Restore->Verify;Verify->Decision;
}

digraph Publish {
 graph [bgcolor="#10151D",pad=.35,rankdir=TB,nodesep=.35,ranksep=.52,labelloc=t,label="DEVFOLIO OS  |  03.1 PUBLISHING PATH (PROPOSED)",fontcolor="#F1F5F9",fontname="Arial",fontsize=21];
 node [shape=box,style="rounded,filled",color="#52677A",fillcolor="#17212D",fontcolor="#F1F5F9",fontname="Arial",fontsize=12,margin=".2,.11"];
 edge [color="#70D9C3",fontcolor="#B0BECC",fontname="Arial",fontsize=10,arrowsize=.65];
 A [label="Owner clicks Publish"];
 B [label="Session + CSRF + authorization"];
 C [label="Server validation + version precondition"];
 D [label="DB transaction:\npublished snapshot + audit + outbox",fillcolor="#194A4B",color="#70D9C3",penwidth=2];
 E [label="Server-confirmed publish result"];
 F [label="Outbox consumer:\nsitemap/cache invalidation + retry"];
 G [label="Anonymous SSR reads only active published snapshot",fillcolor="#173C46"];
 FAIL [label="Any failure: no false success\nretain draft / explain retry",fillcolor="#4A2E39",color="#FDA4AF"];
 A -> B -> C -> D -> E -> F -> G;
 B -> FAIL [label="deny",color="#FDA4AF"];
 C -> FAIL [label="invalid/conflict",color="#FDA4AF"];
 D -> FAIL [label="rollback",color="#FDA4AF"];
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfolio:phase03-04:proposal:PrivateDraft",
  "title": "PrivateDraft",
  "description": "UNAPPROVED contract proposal, not deployed.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string"
    },
    "revision": {
      "type": "integer"
    },
    "draft": {
      "type": "object"
    },
    "publishedRevision": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "revision",
    "draft"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfolio:phase03-04:proposal:PublicSite",
  "title": "PublicSite",
  "description": "UNAPPROVED contract proposal, not deployed.",
  "type": "object",
  "properties": {
    "publicBrand": {
      "type": "string"
    },
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "href"
        ]
      }
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "navigation",
    "theme"
  ]
}

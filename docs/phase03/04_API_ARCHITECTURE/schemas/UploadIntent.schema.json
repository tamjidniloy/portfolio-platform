{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfolio:phase03-04:proposal:UploadIntent",
  "title": "UploadIntent",
  "description": "UNAPPROVED contract proposal, not deployed.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "uploadUrl": {
      "type": "string",
      "format": "uri"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": [
        "staged"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "uploadUrl",
    "expiresAt",
    "state"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfolio:phase03-04:proposal:ContactInput",
  "title": "ContactInput",
  "description": "UNAPPROVED contract proposal, not deployed.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000
    },
    "consent": {
      "type": "boolean"
    },
    "website": {
      "type": "string",
      "description": "Honeypot: must be blank if used"
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "email",
    "message"
  ]
}

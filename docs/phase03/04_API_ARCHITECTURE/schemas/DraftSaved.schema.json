{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devfolio:phase03-04:proposal:DraftSaved",
  "title": "DraftSaved",
  "description": "UNAPPROVED contract proposal, not deployed.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "string",
      "enum": [
        "draft"
      ]
    },
    "savedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "revision",
    "state",
    "savedAt"
  ]
}

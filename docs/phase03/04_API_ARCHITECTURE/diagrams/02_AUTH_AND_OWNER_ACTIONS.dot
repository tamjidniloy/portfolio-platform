digraph Auth_Flow {
 graph [rankdir=LR,bgcolor="#10151d",pad="0.30",fontname="Arial"];node [shape=box,style="rounded,filled",fontname="Arial",fillcolor="#1f2c39",color="#5a7685",fontcolor="#eef5f7"];
 edge [color="#70d9c3",fontcolor="#dbe8ef",fontname="Arial"];
 anon [label="Anonymous / Owner Login"];
 pass [label="Password verification
rate limit"];
 pending [label="Pending email challenge
NO owner session"];
 otp [label="Verify one-use code
TTL and attempts"];
 session [label="Revocable owner session
Secure HttpOnly cookie",fillcolor="#214f48"];
 ui [label="Owner action
Origin + CSRF"];
 authz [label="Object/function authz",fillcolor="#315261"];
 cmd [label="Domain command
If-Match + validation"];
 result [label="Durable commit
then truthful receipt",fillcolor="#214f48"];
 anon->pass->pending->otp->session->ui->authz->cmd->result;
}

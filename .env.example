# DEVFOLIO OS development example only — copy to .env (ignored by Git).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://devfolio_dev:CHANGE_ME@127.0.0.1:5432/devfolio_dev

# Generate your own 32-byte random secret on your PC:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PORTFOLIO_AUTH_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_32_CHARACTERS_OR_LONGER
PORTFOLIO_PUBLIC_ORIGIN=http://127.0.0.1:3000

# For development ONLY; do not configure on a public server:
PORTFOLIO_DEV_PRINT_OTP=true

# Optional locally, mandatory in production for real six-digit owner sign-in.
# Create/verify a sender domain with Resend first.
# RESEND_API_KEY=put_private_key_in_local_env_only
# PORTFOLIO_FROM_EMAIL=Portfolio <login@your-verified-domain.example>

# Uploads default to ./data/uploads in local development.
# Production MUST use a persistent absolute path, e.g. /var/data/uploads.
# PORTFOLIO_UPLOAD_DIR=data/uploads

# Optional scoped trusted reverse proxy CIDR; leave unset unless verified:
# TRUST_PROXY_CIDR=127.0.0.1/32

# Production is configured via render.yaml + Render's Environment page:
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=10000
# PORTFOLIO_PUBLIC_ORIGIN=https://yourdomain.example
# PORTFOLIO_UPLOAD_DIR=/var/data/uploads
# PORTFOLIO_DEV_PRINT_OTP must be unset
# All actual production credentials are supplied privately by Render/Resend.

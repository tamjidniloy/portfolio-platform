# Windows 11 native PostgreSQL, edit locally and never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://devfolio_dev:CHANGE_ME@127.0.0.1:5432/devfolio_dev

# Phase 04.3 CMS is OFF by default; requires real DB-R1 migrations and passkey auth.
# Do not enable against devfolio_dev or production until the full security gate passes.
# CMS_API_ENABLED=false
# CMS_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/REVIEWED_DB_R1
# CMS_PUBLIC_ORIGIN=http://127.0.0.1:3000
# CMS_CSRF_SECRET=GENERATE_UNIQUE_RANDOM_SERVER_ONLY_SECRET_AT_LEAST_32_BYTES

# Owner-approved R1 authentication (enabled only after release DB migration)
# CMS_AUTH_ENABLED=false
# WEBAUTHN_RP_ID=localhost
# OWNER_BOOTSTRAP_DATABASE_URL=postgresql://YOUR_MIGRATOR:REDACTED@127.0.0.1:5432/YOUR_DB
# OWNER_BOOTSTRAP_CONFIRM=YOUR_DB
# OWNER_BOOTSTRAP_EMAIL=you@example.test
# MIGRATION_DATABASE_URL=postgresql://YOUR_MIGRATOR:REDACTED@127.0.0.1:5432/YOUR_DB
# MIGRATION_APPLY_CONFIRM=YOUR_DB

# REQUIRED in production: independent read-only PostgreSQL login that can SELECT
# published_snapshots + approved redirects only. NEVER reuse CMS owner DB credentials.
# CMS_PUBLIC_DATABASE_URL=postgresql://PUBLIC_READER:REDACTED@127.0.0.1:5432/YOUR_DB

# RETENTION_DATABASE_URL=postgresql://PRIVILEGED_OPERATOR:REDACTED@127.0.0.1:5432/YOUR_DB
# RETENTION_APPLY_CONFIRM=YOUR_DB
# OWNER_RECOVERY_CONFIRM=REVOKE_ALL_OWNER_AUTHENTICATORS

# 04.4 — OFF by default. Private S3-compatible bucket; no public ACL.
# MEDIA_ENABLED=false
# MEDIA_S3_BUCKET=your-private-media-bucket
# MEDIA_S3_REGION=auto
# MEDIA_S3_ENDPOINT=https://your-approved-storage-endpoint.example
# MEDIA_S3_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=NEVER_COMMIT
# AWS_SECRET_ACCESS_KEY=NEVER_COMMIT
# CONTACT_ENABLED=false
# CONTACT_NOTICE_VERSION=2026-10-24-v1
# CONTACT_IP_PEPPER=32+BYTE_HIGH_ENTROPY_SECRET
# EMAIL_PROVIDER=disabled
# RESEND_API_KEY=NEVER_COMMIT
# CONTACT_FROM_EMAIL=verified-sender@example.com
# CONTACT_OWNER_EMAIL=owner@example.com
# CACHE_PURGE_MODE=no-store
# CLOUDFLARE_ZONE_ID=your-zone-id
# CLOUDFLARE_API_TOKEN=NEVER_COMMIT
# OUTBOX_DATABASE_URL=postgresql://OPERATOR:REDACTED@127.0.0.1:5432/YOUR_DB
# OUTBOX_RUN_CONFIRM=YOUR_DB

# NEW: Simplified owner-only portfolio studio (independent of the old CMS flags).
# Run npm run portfolio:setup ONCE to set your email and password privately.
# Generate a unique 32+ character secret; keep it in .env, never commit it.
PORTFOLIO_AUTH_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_32_CHARACTERS_OR_LONGER
PORTFOLIO_PUBLIC_ORIGIN=http://127.0.0.1:3000
# Local development ONLY: print the six-digit code in the terminal if no email sender is configured.
PORTFOLIO_DEV_PRINT_OTP=true
# To receive actual sign-in emails, configure Resend and a verified sender instead:
# RESEND_API_KEY=your_private_resend_key
# PORTFOLIO_FROM_EMAIL=Portfolio <login@your-verified-domain.com>
# Persist this directory on your deployed host. Do not commit uploaded files.
# PORTFOLIO_UPLOAD_DIR=data/uploads

# Local development for DEVFOLIO OS (copy to .env; never commit the real file).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://devfolio_dev:CHANGE_ME@127.0.0.1:5432/devfolio_dev

# Replace with a UNIQUE random 64-character hex secret from:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PORTFOLIO_AUTH_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_32_CHARACTERS_OR_LONGER
PORTFOLIO_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Local-only six-digit verification code printed to the WebStorm server terminal.
# NEVER enable in real production.
PORTFOLIO_DEV_PRINT_OTP=true

# For real OTP email and optional visitor contact-form delivery, configure Resend:\n# The public contact destination is set separately in Admin → Contact.\n# The form stays hidden when these are not configured.
# RESEND_API_KEY=
# PORTFOLIO_FROM_EMAIL=Portfolio <login@your-verified-domain.com>

# Defaults to data/uploads, which must remain persisted and backed up.
# PORTFOLIO_UPLOAD_DIR=data/uploads

# Optional: exact trusted reverse-proxy private IPv4 CIDR, e.g. 127.0.0.1/32.
# TRUST_PROXY_CIDR=

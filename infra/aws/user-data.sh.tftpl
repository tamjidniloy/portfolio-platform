#!/bin/bash
set -euo pipefail
dnf install -y nodejs22 nodejs22-npm amazon-cloudwatch-agent curl
id devfolio || useradd --system --home-dir /opt/devfolio --shell /sbin/nologin devfolio
install -d -m 0755 /opt/devfolio/releases /etc/devfolio
install -d -m 0750 -o devfolio -g devfolio /var/log/devfolio
cat >/etc/devfolio/host.env <<'HOSTENV'
ENV_SECRET_ARN=${env_secret_arn}
AWS_REGION=${aws_region}
APP_LOG_GROUP=${log_group}
RELEASE_BUCKET=${release_bucket}
RELEASE_ENVIRONMENT=${environment}
RELEASE_PARAMETER=${release_parameter}
RELEASE_SIGNING_KEY_ARN=${release_signing_key}
HOSTENV
chmod 0600 /etc/devfolio/host.env
cat >/etc/systemd/system/devfolio.service <<'UNIT'
[Unit]
Description=DEVFOLIO OS Node22 SSR
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=devfolio
Group=devfolio
WorkingDirectory=/opt/devfolio/current
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
EnvironmentFile=/etc/devfolio/runtime.env
ExecStart=/usr/bin/node-22 server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/devfolio
PrivateTmp=true
StandardOutput=append:/var/log/devfolio/app.log
StandardError=append:/var/log/devfolio/app.log
[Install]
WantedBy=multi-user.target
UNIT
cat >/etc/systemd/system/devfolio-outbox.service <<'UNIT'
[Unit]
Description=DEVFOLIO OS outbox single batch
[Service]
Type=oneshot
User=devfolio
Group=devfolio
WorkingDirectory=/opt/devfolio/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/devfolio/runtime.env
ExecStart=/usr/bin/node-22 server/integrations/outbox-run.mjs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/devfolio/outbox.log
StandardError=append:/var/log/devfolio/outbox.log
UNIT
cat >/etc/systemd/system/devfolio-outbox.timer <<'UNIT'
[Unit]
Description=DEVFOLIO OS outbox every minute
[Timer]
OnBootSec=2m
OnUnitInactiveSec=1m
Unit=devfolio-outbox.service
[Install]
WantedBy=timers.target
UNIT
cat >/etc/systemd/system/devfolio-retention.service <<'UNIT'
[Unit]
Description=DEVFOLIO OS operator-reviewed retention sweep
[Service]
Type=oneshot
User=devfolio
Group=devfolio
WorkingDirectory=/opt/devfolio/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/devfolio/runtime.env
ExecStart=/usr/bin/node-22 scripts/retention-run.mjs --apply
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/devfolio/retention.log
StandardError=append:/var/log/devfolio/retention.log
UNIT
cat >/etc/systemd/system/devfolio-retention.timer <<'UNIT'
[Unit]
Description=DEVFOLIO OS retention nightly, only enable after policy approval
[Timer]
OnCalendar=*-*-* 02:00:00
Persistent=true
Unit=devfolio-retention.service
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
# Timers are deliberately NOT enabled by provisioning. Operational acceptance first.
cat >/opt/aws/amazon-cloudwatch-agent/etc/devfolio.json <<'CONFIG'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/devfolio/app.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-app"},
          {"file_path": "/var/log/devfolio/outbox.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-outbox"},
          {"file_path": "/var/log/devfolio/retention.log", "log_group_name": "${log_group}", "log_stream_name": "{instance_id}-retention"}
        ]
      }
    }
  }
}
CONFIG
touch /var/log/devfolio/app.log /var/log/devfolio/outbox.log /var/log/devfolio/retention.log
chown devfolio:devfolio /var/log/devfolio/*.log
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/devfolio.json

# Restore the last approved, signed build when Auto Scaling replaces a host.
source /etc/devfolio/host.env
if approved_sha="$(aws ssm get-parameter --name "$RELEASE_PARAMETER" --region "$AWS_REGION" --query Parameter.Value --output text)" &&
   [[ "$approved_sha" =~ ^[a-f0-9]{64}$ ]]; then
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  aws s3 cp "s3://$RELEASE_BUCKET/releases/$RELEASE_ENVIRONMENT/$approved_sha.tgz" "$tmp/release.tgz" --only-show-errors
  echo "$approved_sha  $tmp/release.tgz" | sha256sum --check --status
  tar -xOzf "$tmp/release.tgz" ops/aws/deploy-host.sh > "$tmp/deploy-host.sh"
  bash "$tmp/deploy-host.sh" "$approved_sha" "$RELEASE_BUCKET" "$RELEASE_ENVIRONMENT"
else
  echo "No trusted release pointer yet; EC2 remains out of target service."
fi

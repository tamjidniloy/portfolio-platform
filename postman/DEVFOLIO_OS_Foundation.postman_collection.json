          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test('no secret leakage', function () { pm.expect(pm.response.text()).to.not.include('DATABASE_URL='); });"
